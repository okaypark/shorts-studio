# 이 파일을 복사해서 .env 로 이름을 바꾸고, 각자 발급받은 키를 넣으세요.
# .env 는 절대 커밋하지 않습니다. 키는 파트너 각자의 것을 씁니다.

# 음성 합성(선택) — 쓰지 않으면 비워두세요
TTS_PROVIDER=
TTS_API_KEY=

# OpenVoice V2 (선택) — 비우면 프로젝트의 .tools/miniconda를 자동 탐색합니다.
OPENVOICE_PROFILE=my_voice
# CONDA_EXE=C:\\path\\to\\condabin\\conda.bat

# 이미지 생성(선택)
IMAGE_API_KEY=
